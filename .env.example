# ============================================================
# DATABASE (Prisma / MariaDB - Hostinger)
# ============================================================
# MySQL/MariaDB connection string (Prisma 7 + @prisma/adapter-mariadb).
# Remote access must be enabled in hPanel > Databases > Remote MySQL.
# DIRECT_URL is optional; migrations fall back to DATABASE_URL.
DATABASE_URL="mysql://[DB_USER]:[PASSWORD]@[HOST].hstgr.io:3306/[DB_NAME]?connectionLimit=5&connectTimeout=15000"

# ============================================================
# SSO AUTHENTICATION
# ============================================================
# The shared JWT secret between this app and sso.hnsitcenter.id
JWT_SECRET="your_shared_jwt_secret"

# ============================================================
# CLOUDFLARE R2 STORAGE
# ============================================================
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="hris-hns"
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.yourdomain.com"

# ============================================================
# EMAIL (Resend)
# ============================================================
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@hnsitcenter.id"
RESEND_WEBHOOK_SECRET="whsec_..."

# ============================================================
# WEB PUSH NOTIFICATIONS
# ============================================================
VAPID_SUBJECT="mailto:admin@hnsitcenter.id"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="public_key..."
VAPID_PRIVATE_KEY="private_key..."

# ============================================================
# CRON JOBS
# ============================================================
# Generate with: openssl rand -base64 32
CRON_SECRET="your_random_cron_secret"
